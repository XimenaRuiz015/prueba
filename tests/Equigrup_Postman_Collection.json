{
  "info": {
    "_postman_id": "equigrup-qa-monitoring-collection-2026",
    "name": "Equigrup - Suite de Pruebas y Monitoreo (Producción Cloud)",
    "description": "Colección oficial de Postman para pruebas funcionales, integración, base de datos, seguridad y monitoreo en tiempo real del Asistente Inteligente Equi (Equigrup).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://agente-equigrup.onrender.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Monitoreo de Disponibilidad - Web SPA (Health Check)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Estado HTTP es 200 OK (Servidor en línea)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Interfaz MVVM cargada correctamente', function () {",
              "    pm.expect(pm.response.text()).to.include('Equigrup');",
              "});",
              "pm.test('Tiempo de respuesta aceptable (< 10000ms)', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(10000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "2. Base de Datos - Consultar Catálogo de 52 Proyectos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Estado HTTP es 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Retorna arreglo JSON de proyectos', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "    pm.expect(jsonData.length).to.be.at.least(50);",
              "});",
              "pm.test('Proyectos contienen estructura completa (id, titulo, estado)', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData[0]).to.have.property('id');",
              "    pm.expect(jsonData[0]).to.have.property('titulo');",
              "    pm.expect(jsonData[0]).to.have.property('estado');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/proyectos",
          "host": ["{{base_url}}"],
          "path": ["api", "proyectos"]
        }
      }
    },
    {
      "name": "3. Seguridad - Rechazo de Credenciales Inválidas (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Bloquea acceso no autorizado con código 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test('Retorna mensaje de error de seguridad', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.detail).to.include('Credenciales incorrectas');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"usuario_intruso\",\n  \"password\": \"clave_falsa_123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
