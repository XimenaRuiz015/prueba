# ==============================================================
# CONFIGURACIÓN DE ENTORNO - ASISTENTE VIRTUAL EQUIGRUP
# ==============================================================
# Copia este archivo como '.env' para desarrollo local:
# cp .env.example .env

# --- PROVEEDOR LLM (OLLAMA / CLOUD) ---
# URL base de Ollama (por defecto http://localhost:11434 para local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# --- PROVEEDORES LLM EN LA NUBE GRATUITOS (OPCIONAL / PARA DESPLIEGUE) ---
# Si despliegas en la nube (Render, Hugging Face, etc.) donde Ollama local no corre,
# puedes usar una API Key 100% gratuita para que el asistente funcione sin límites:
#
# 1. Groq (Recomendado: 100% gratis, ultra rápido, usa la misma familia Llama 3.2 / 3.3):
#    Consigue tu clave gratis en: https://console.groq.com/keys
GROQ_API_KEY=

# 2. Google Gemini (100% gratis, modelo gemini-2.0-flash / gemini-1.5-flash):
#    Consigue tu clave gratis en: https://aistudio.google.com/
GEMINI_API_KEY=

# --- SERVICIO DE CORREO SMTP (RECUPERACIÓN DE CONTRASEÑAS) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_de_google
SMTP_FROM_NAME=Equigrup Seguridad

